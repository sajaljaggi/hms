# Leave unset for local dev (Vite proxy) and for the docker-compose/nginx
# setup — both make relative '/api' and '/uploads' paths work already.
#
# Set this only when the frontend and backend are deployed to different
# domains (e.g. Vercel + Render): the backend's origin, no trailing slash.
# Vite bakes this in at BUILD time, so it must be set in your hosting
# provider's project settings before each deploy, not just in a local file.
VITE_BACKEND_URL=https://your-backend.onrender.com
