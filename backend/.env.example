# Not 5000: macOS AirPlay Receiver listens there. frontend/vite.config.ts proxies /api to 5001.
PORT=5001
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hms_db
# Set DB_SSL=true for a managed MySQL host (Aiven, RDS, ...) — leave
# unset/false for a local instance.
DB_SSL=false
# The host's CA cert (PEM text, e.g. Aiven's Overview tab -> "CA certificate").
# Required to actually verify the TLS chain when DB_SSL=true; without it the
# connection is still encrypted but not verified against a MITM.
DB_CA_CERT=
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=a_different_super_secret_key_change_in_production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Razorpay. With both keys empty, payments use mock mode only when NODE_ENV is
# development or test, or PAYMENT_MODE=mock is set. Otherwise payment is disabled (503).
# Webhook secret is the one set on the Razorpay webhook, not the key secret.
# PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Jitsi server for teleconsultation video rooms.
JITSI_DOMAIN=meet.jit.si
